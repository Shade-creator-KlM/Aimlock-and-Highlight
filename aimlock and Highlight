--==================================================
-- TARGET PART FINDER
--==================================================

local function getTargetPart(character)

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character.PrimaryPart
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("Head")
end

--==================================================
-- GET PLAYER TARGET
--==================================================

local function getPlayerTarget()

	local closest = nil
	local closestDistance = math.huge

	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	for _, player in Players:GetPlayers() do

		if player ~= LocalPlayer then

			local character = player.Character

			local humanoid =
				character
				and character:FindFirstChildOfClass("Humanoid")

			local body = getTargetPart(character)

			if humanoid
				and body
				and humanoid.Health > 0 then

				local screenPosition, visible =
					Camera:WorldToViewportPoint(
						body.Position
					)

				if visible then

					local distance = (
						Vector2.new(
							screenPosition.X,
							screenPosition.Y
						) - center
					).Magnitude

					if distance < closestDistance then

						closestDistance = distance
						closest = player
					end
				end
			end
		end
	end

	return closest
end

--==================================================
-- GET NPC TARGET
--==================================================

local function getNPCTarget()

	local closest = nil
	local closestDistance = math.huge

	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	for _, object in workspace:GetDescendants() do

		if object:IsA("Model") then

			local humanoid =
				object:FindFirstChildOfClass("Humanoid")

			if humanoid and humanoid.Health > 0 then

				-- Ignore player characters
				if not Players:GetPlayerFromCharacter(object) then

					local body = getTargetPart(object)

					if body and body:IsA("BasePart") then

						local screenPosition, visible =
							Camera:WorldToViewportPoint(
								body.Position
							)

						if visible then

							local distance = (
								Vector2.new(
									screenPosition.X,
									screenPosition.Y
								) - center
							).Magnitude

							if distance < closestDistance then

								closestDistance = distance
								closest = object
							end
						end
					end
				end
			end
		end
	end

	return closest
end

--==================================================
-- TARGET VALIDATION
--==================================================

local function isValidTarget(target)

	if not target then
		return false
	end

	-- PLAYER
	if target:IsA("Player") then

		if not PlayersEnabled then
			return false
		end

		local character = target.Character

		if not character then
			return false
		end

		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		local body =
			getTargetPart(character)

		return humanoid
			and body
			and humanoid.Health > 0
	end

	-- NPC
	if target:IsA("Model") then

		if not NPCsEnabled then
			return false
		end

		local humanoid =
			target:FindFirstChildOfClass("Humanoid")

		local body =
			getTargetPart(target)

		return humanoid
			and body
			and humanoid.Health > 0
	end

	return false
end

--==================================================
-- FIND TARGET
--==================================================

local function findTarget()

	local playerTarget = nil
	local npcTarget = nil

	if PlayersEnabled then
		playerTarget = getPlayerTarget()
	end

	if NPCsEnabled then
		npcTarget = getNPCTarget()
	end

	-- Nothing enabled
	if not PlayersEnabled and not NPCsEnabled then
		return nil
	end

	-- Players only
	if PlayersEnabled and not NPCsEnabled then
		return playerTarget
	end

	-- NPCs only
	if NPCsEnabled and not PlayersEnabled then
		return npcTarget
	end

	-- Both enabled
	if playerTarget and not npcTarget then
		return playerTarget
	end

	if npcTarget and not playerTarget then
		return npcTarget
	end

	if not playerTarget and not npcTarget then
		return nil
	end

	-- Both exist: choose closest to screen center

	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	local function getDistance(target)

		local character

		if target:IsA("Player") then
			character = target.Character
		else
			character = target
		end

		local body =
			getTargetPart(character)

		if not body then
			return math.huge
		end

		local position =
			Camera:WorldToViewportPoint(
				body.Position
			)

		return (
			Vector2.new(
				position.X,
				position.Y
			) - center
		).Magnitude
	end

	if getDistance(playerTarget)
		<= getDistance(npcTarget) then

		return playerTarget

	else

		return npcTarget
	end
end

--==================================================
-- DISABLE AIMLOCK
--==================================================

local function disableAimlock()

	CurrentTarget = nil
	AimlockEnabled = false

	AimButton.Text = "AIMLOCK: OFF"
end

--==================================================
-- BUTTONS
--==================================================

PlayersButton.Activated:Connect(function()

	PlayersEnabled = not PlayersEnabled

	PlayersButton.Text =
		PlayersEnabled
		and "PLAYERS: ON"
		or "PLAYERS: OFF"

	-- If current target is a player
	-- and player targeting gets disabled
	if CurrentTarget
		and CurrentTarget:IsA("Player")
		and not PlayersEnabled then

		disableAimlock()
	end
end)

NPCButton.Activated:Connect(function()

	NPCsEnabled = not NPCsEnabled

	NPCButton.Text =
		NPCsEnabled
		and "NPCs: ON"
		or "NPCs: OFF"

	-- If current target is an NPC
	-- and NPC targeting gets disabled
	if CurrentTarget
		and CurrentTarget:IsA("Model")
		and not NPCsEnabled then

		disableAimlock()
	end
end)

AimButton.Activated:Connect(function()

	AimlockEnabled = not AimlockEnabled

	AimButton.Text =
		AimlockEnabled
		and "AIMLOCK: ON"
		or "AIMLOCK: OFF"

	if not AimlockEnabled then
		CurrentTarget = nil
	end
end)

--==================================================
-- AIMLOCK
--==================================================

RunService.RenderStepped:Connect(function()

	if not AimlockEnabled then
		return
	end

	-- Keep the SAME target
	if CurrentTarget then

		-- Target died/reset
		if not isValidTarget(CurrentTarget) then
			disableAimlock()
			return
		end
	end

	-- Pick target only if we don't already have one
	if not CurrentTarget then

		CurrentTarget = findTarget()

		if not CurrentTarget then
			return
		end
	end

	local character

	if CurrentTarget:IsA("Player") then
		character = CurrentTarget.Character
	else
		character = CurrentTarget
	end

	local body =
		getTargetPart(character)

	if not body then
		disableAimlock()
		return
	end

	-- Lock camera onto current target
	Camera.CFrame = CFrame.lookAt(
		Camera.CFrame.Position,
		body.Position
	)
end)

